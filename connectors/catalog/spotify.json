{
  "id": "spotify",
  "name": "Spotify",
  "type": "first-party",
  "transport": "api",
  "auth": "oauth2",
  "authorize_url": "https://accounts.spotify.com/authorize",
  "token_url": "https://accounts.spotify.com/api/token",
  "client_id_env": "SPOTIFY_CLIENT_ID",
  "oauth_setup_url": "https://developer.spotify.com/dashboard",
  "redirect_uri": "http://127.0.0.1:8768/oauth/spotify/callback",
  "oauth_scopes": [
    "user-read-playback-state",
    "user-modify-playback-state",
    "user-read-currently-playing"
  ],
  "scopes": ["playback.read", "playback.control"],
  "tool_refs": {
    "spotify.currently_playing": "playback.read",
    "spotify.play": "playback.control"
  }
}
