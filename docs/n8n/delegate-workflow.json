{
  "name": "JARVIS VII — Delegate (desktop tool via n8n)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-delegate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://127.0.0.1:8766/tool/{{ $json.body.tool }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-JARVIS-TOKEN", "value": "={{ $credentials.tokenValue }}" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "jsonBody": "={{ { \"args\": $json.body.args || {} } }}",
        "options": {}
      },
      "id": "call-tool",
      "name": "Call JARVIS Tool",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"tool\": $json.name, \"result\": $json.result } }}",
        "options": {}
      },
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Call JARVIS Tool", "type": "main", "index": 0 }]] },
    "Call JARVIS Tool": { "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": {},
  "pinData": {}
}
